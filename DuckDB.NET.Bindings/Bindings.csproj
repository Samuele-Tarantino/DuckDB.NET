<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>DuckDB Bindings for C#.</Description>
    <PackageReleaseNotes>
- Updated to DuckDB v2.0.0

New features:
- Added binding for duckdb_create_bignum and the DuckDBBignum struct
    </PackageReleaseNotes>
    <RootNamespace>DuckDB.NET.Native</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx</RuntimeIdentifiers>
    <DuckDbArtifactRoot Condition=" '$(DuckDbArtifactRoot)' == '' ">https://github.com/duckdb/duckdb/releases/download/v2.0.0</DuckDbArtifactRoot>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\keyPair.snk</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<PropertyGroup Condition="'$(BuildType)' == 'ManagedOnly' ">
		<Description>$(Description) $(NoNativeText)</Description>
	</PropertyGroup>

	<!-- Download and include the native libraries into the NuGet package-->
	<Target Name="DownloadNativeLibs" BeforeTargets="GenerateAdditionalSources" Condition="'$(BuildType)' == 'Full' AND '$(TargetFramework)' == '$([System.String]::Copy($(TargetFrameworks)).Split(%27;%27)[0])'">
		<ItemGroup Condition="'$(NightlyBuild)' != 'true'">
			<_NativeLib Include="win-x64" LibUrl="$(DuckDbArtifactRoot)/duckdb-shared-libs-windows-amd64.tar.gz" />
			<_NativeLib Include="win-arm64" LibUrl="$(DuckDbArtifactRoot)/duckdb-shared-libs-windows-arm64.tar.gz" />
			<_NativeLib Include="linux-x64" LibUrl="$(DuckDbArtifactRoot)/duckdb-shared-libs-linux-amd64.tar.gz" />
			<_NativeLib Include="linux-arm64" LibUrl="$(DuckDbArtifactRoot)/duckdb-shared-libs-linux-arm64.tar.gz" />
			<_NativeLib Include="osx" LibUrl="$(DuckDbArtifactRoot)/duckdb-shared-libs-osx-universal.tar.gz" />
		</ItemGroup>
		<ItemGroup Condition="'$(NightlyBuild)' == 'true'">
			<_NativeLib Include="win-x64" LibUrl="$(DuckDbArtifactRoot)/duckdb-shared-libs-windows-amd64.tar.gz" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
			<_NativeLib Include="linux-x64" LibUrl="$(DuckDbArtifactRoot)/duckdb-shared-libs-linux-amd64.tar.gz" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
			<_NativeLib Include="osx" LibUrl="$(DuckDbArtifactRoot)/duckdb-shared-libs-osx-universal.tar.gz" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
		</ItemGroup>
		<MSBuild Projects="DownloadNativeLibs.targets" Properties="Rid=%(_NativeLib.Identity);LibUrl=%(_NativeLib.LibUrl);NightlyBuild=$(NightlyBuild);NativeDownloadRetries=$(NativeDownloadRetries);NativeDownloadRetryDelayMilliseconds=$(NativeDownloadRetryDelayMilliseconds)" />
	</Target>
	<Target Name="CleanNativeLibs" BeforeTargets="Clean" Condition="'$(BuildType)' == 'Full' ">
		<RemoveDir Directories="obj\runtimes" />
	</Target>
	<ItemGroup Condition="'$(BuildType)' == 'Full' ">
		<None Include="obj\runtimes\**\*.dll;obj\runtimes\**\*.so;obj\runtimes\**\*.dylib;">
			<Visible>false</Visible>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>\runtimes</PackagePath>
			<Link>runtimes\%(RecursiveDir)\%(FileName)%(Extension)</Link>
		</None>
	</ItemGroup>
	<ItemGroup Condition="'$(CI)' == 'true'">
		<PackageReference Include="GitVersion.MsBuild" Version="6.4.0" PrivateAssets="all" />
	</ItemGroup>
	<!-- End native lib section -->
</Project>
